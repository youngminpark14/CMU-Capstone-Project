# Copy to .env (git-ignored) or export these in your shell. Nothing here is required for
# `pmfa replay` or the test suite: both run offline with no keys.

# Claude API key: backtest, shadow and demo modes make live model calls.
ANTHROPIC_API_KEY=

# Kalshi DEMO exchange credentials (mock funds): only for `pmfa demo`.
# Create them at https://demo.kalshi.co. The production exchange is never used for orders.
KALSHI_DEMO_KEY_ID=
# Either a path to the PEM private key file ...
KALSHI_DEMO_PRIVATE_KEY_PATH=
# ... or the PEM text itself (literal \n line breaks are accepted).
KALSHI_DEMO_PRIVATE_KEY=

# Optional: path to a configuration file (default: ./pmfa.toml if present, else built-in defaults).
PMFA_CONFIG=
