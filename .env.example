# Every environment variable pmfa reads. This is a list to copy from, not a file anything loads:
# pmfa reads secrets from the process environment only and never reads a .env file (CrewAI's
# own .env loading is switched off). Export the ones you use in your shell, for example
#     export ANTHROPIC_API_KEY=...
# and leave the rest unset. Nothing here is required for `pmfa replay` or the test suite:
# both run offline with no keys.

# Claude API key: backtest, shadow and demo modes make live model calls.
ANTHROPIC_API_KEY=

# Kalshi DEMO exchange credentials (mock funds): only for `pmfa demo`.
# Create them at https://demo.kalshi.co. The production exchange is never used for orders.
KALSHI_DEMO_KEY_ID=
# Either a path to the PEM private key file ...
KALSHI_DEMO_PRIVATE_KEY_PATH=
# ... or the PEM text itself (literal \n line breaks are accepted).
KALSHI_DEMO_PRIVATE_KEY=

# Optional: path to a configuration file (default: ./pmfa.toml if present, else built-in
# defaults). An empty value means not set.
PMFA_CONFIG=

# Optional: the directory for the all-MiniLM-L6-v2 embedding model files, when the "minilm"
# embedder is chosen (default: chromadb's own cache under ~/.cache/chroma).
PMFA_MINILM_CACHE=

# Optional, tests only: set to 1 to run the opt-in smoke tests (`uv run pytest -m smoke`).
# They call live services: Kalshi production (public data), the Kalshi demo exchange (read
# only, needs the KALSHI_DEMO_* variables) and one Claude call (needs ANTHROPIC_API_KEY).
# They never run in CI.
PMFA_SMOKE=
